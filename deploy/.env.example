# CatPital 生产环境变量（复制为 deploy/.env，不要提交）
# 生成随机值：openssl rand -hex 32

# ---------- 对外端口 ----------
# 宿主机上唯一占用的端口；默认只绑定 127.0.0.1，由 1Panel/OpenResty 反代
APP_PORT=38080
APP_BIND=127.0.0.1

# ---------- 数据库（只在 compose 私有网络里，不映射到宿主机） ----------
# 请用 hex 随机串，避免特殊字符破坏连接串
POSTGRES_PASSWORD=

# ---------- Discord ----------
DISCORD_CLIENT_ID=1560322898856640664
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_BROADCAST_CHANNEL_ID=
DISCORD_LOCALE=zh-CN

# ---------- 后端 ----------
JWT_SECRET=
# 外部货币接口主密钥（32 字节 hex）；留空则接口返回 503
API_SECRET_KEY=
HMAC_MAX_SKEW_SECONDS=300
ENGINE_ENABLED=1
LEADERBOARD_SETTLEMENT=1
DANMAKU_COOLDOWN_MS=1500

# ---------- 经济参数 ----------
INITIAL_GRANT=10000
BANKRUPTCY_RELIEF=5000
BANKRUPTCY_DUST_THRESHOLD=0
LEADERBOARD_MIN_CAPITAL=1000
BIG_WIN_ROE_THRESHOLD=1.0
BIG_WIN_PNL_THRESHOLD=10000
DEFICIT_BROADCAST_THRESHOLD=0
LEADERBOARD_REWARD_DAILY=1000
LEADERBOARD_REWARD_WEEKLY=5000
LEADERBOARD_REWARD_MONTHLY=20000

# ---------- 可选：Cloudflare Tunnel（docker compose --profile tunnel up -d） ----------
CLOUDFLARE_TUNNEL_TOKEN=
