# ---------- Discord ----------
# Application ID（公开信息）
DISCORD_CLIENT_ID=1560322898856640664
# OAuth2 Client Secret / Bot Token：开发者后台获取，绝不能提交到仓库
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# 前端只能读取 VITE_ 前缀变量（Client ID 是公开信息，Secret 绝不能进前端）
VITE_DISCORD_CLIENT_ID=1560322898856640664
# 斜杠命令注册到哪个服务器（开发期按服务器注册立即生效；--global 则忽略）
DISCORD_GUILD_ID=
# 全局默认播报频道；各服务器也可用 /admin_set_channel 单独设置
DISCORD_BROADCAST_CHANNEL_ID=
# 播报语言（服务器未单独设置时）：zh-CN | en-US | es-ES
DISCORD_LOCALE=zh-CN
# 临时管理面板白名单："<Discord UID>:<Discord 用户名>"，多个用逗号分隔；UID 和用户名必须同时匹配。
# 留空 = 面板完全不存在（接口 404、前端不显示入口）
ADMIN_PANEL_USERS=
# 注：本项目 Bot 走 Gateway 连接，不需要 Public Key（仅当改用 HTTP Interactions Endpoint 时才用于验签）

# ---------- 后端 ----------
DATABASE_URL=postgresql://catpital:catpital@localhost:5432/catpital
# 留空 = 进程内事件总线（单实例开发）；多实例部署必须配置
REDIS_URL=redis://localhost:6379
API_PORT=3001
# 后端真实挂载前缀（与 Discord URL Mapping 的 Target 路径对齐，见 docs/phase-1-architecture.md §2）
API_BASE_PATH=/api
WS_PATH=/ws
JWT_SECRET=change-me
# 仅开发：开启 POST /api/v1/auth/dev 免 Discord 登录（production 下强制关闭）
DEV_LOGIN=0
# 多实例部署时只允许一个实例运行行情/风控引擎、榜单结算
ENGINE_ENABLED=1
LEADERBOARD_SETTLEMENT=1
# 外部行情适配器
ALPHAVANTAGE_API_KEY=
# 弹幕冷却（毫秒）
DANMAKU_COOLDOWN_MS=1500

# ---------- 外部货币接口（跨 Bot 充值 / 提现） ----------
# 接入方密钥的加密主密钥，32 字节（64 位 hex 或 base64）；留空则接口返回 503
#   生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET_KEY=
# HMAC 签名允许的时钟偏差（秒）
HMAC_MAX_SKEW_SECONDS=300

# ---------- 经济参数（全部按字符串解析为 Decimal） ----------
INITIAL_GRANT=10000
BANKRUPTCY_RELIEF=5000
BANKRUPTCY_DUST_THRESHOLD=0
LEADERBOARD_MIN_CAPITAL=1000
BIG_WIN_ROE_THRESHOLD=1.0
BIG_WIN_PNL_THRESHOLD=10000
# 穿仓额达到该值才全服播报 DEFICIT（0 = 全部播报）
DEFICIT_BROADCAST_THRESHOLD=0
# 榜单第一名奖金（收益率榜、富豪榜各一份；计入外部资金流，不影响收益率排名）
LEADERBOARD_REWARD_DAILY=1000
LEADERBOARD_REWARD_WEEKLY=5000
LEADERBOARD_REWARD_MONTHLY=20000

# ---------- Skylbot 货币兑换（Bolívares ⇄ Meow Coin，1:1；说明见 docs/skylbot-exchange.md） ----------
# Skylbot（main.py）Flask 的地址，填了才开放兑换。Docker 部署、Skylbot 在宿主机上时用 http://host.docker.internal:5000
SKYLBOT_API_URL=
